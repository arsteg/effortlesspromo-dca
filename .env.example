# Required
EFFORTLESSPROMO_DCA_ENVIRONMENT=development
EFFORTLESSPROMO_DCA_DATABASE_URL=sqlite:///./dca.db

# Inbound service auth (fail-closed: unset => every privileged call is 401)
EFFORTLESSPROMO_DCA_SERVICE_AUTH_TOKEN=

# Outbound: existing effortlesspromo-ai gateway (empty => AI-dependent features disabled)
EFFORTLESSPROMO_DCA_AI_BASE_URL=
EFFORTLESSPROMO_DCA_AI_SERVICE_TOKEN=

# 24/7 worker loop (off by default)
EFFORTLESSPROMO_DCA_WORKER_ENABLED=false
EFFORTLESSPROMO_DCA_WORKER_INTERVAL_SECONDS=3600

# Sources — synthetic fixtures only; nothing fetches until enabled
EFFORTLESSPROMO_DCA_SYNTHETIC_SOURCES_ENABLED=false

# Schema management (set false once real migrations exist)
EFFORTLESSPROMO_DCA_AUTO_CREATE_SCHEMA=true
