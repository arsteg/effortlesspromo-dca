{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DCA API (uvicorn :8100)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.asgi:app", "--reload", "--port", "8100"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "DCA tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
